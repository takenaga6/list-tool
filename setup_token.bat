@echo off
echo ============================================
echo  HubSpot トークン 初期設定
echo  （初回のみ。一度設定すれば次回から不要）
echo ============================================
echo.
echo HubSpot の APIトークンを入力してください。
echo （入力内容は画面に表示されません）
echo.
set /p TOKEN="トークン: "

if "%TOKEN%"=="" (
    echo 入力がありませんでした。設定をキャンセルします。
    pause
    exit /b 1
)

setx HUBSPOT_TOKEN "%TOKEN%"

echo.
echo ============================================
echo  トークンの設定が完了しました。
echo ============================================
pause
